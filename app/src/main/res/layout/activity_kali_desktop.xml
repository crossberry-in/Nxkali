<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/noxs_background">

    <TextView
        android:id="@+id/kali_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kali_desktop_hint"
        android:textColor="@color/noxs_text"
        android:padding="8dp" />

    <EditText
        android:id="@+id/kali_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/kali_desktop_password_hint"
        android:inputType="textPassword"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kali_connect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kali_desktop_connect" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kali_stop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kali_desktop_stop" />
    </LinearLayout>

    <ImageView
        android:id="@+id/kali_desktop_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:contentDescription="@string/title_kali_desktop"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/kali_text_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/kali_desktop_input_hint"
            android:inputType="text"
            android:singleLine="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kali_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kali_desktop_send" />
    </LinearLayout>
</LinearLayout>
