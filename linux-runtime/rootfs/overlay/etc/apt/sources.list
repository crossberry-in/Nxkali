# /etc/apt/sources.list — Noxs sandbox (Kali Linux (NetHunter Rootless) kali-rolling, canonical copy)
# NOTE: the app installs the FINAL definition as
# /etc/apt/sources.list.d/noxs.sources (deb822). arm64/armhf use the ports
# mirror; this reference file documents the arm64 (default) repositories.
Types: deb
URIs: https://ports.kali.com/kali-ports
Suites: kali-rolling kali-rolling-updates kali-rolling-backports
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/kali-archive-keyring.gpg

Types: deb
URIs: https://ports.kali.com/kali-ports
Suites: kali-rolling-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/kali-archive-keyring.gpg
